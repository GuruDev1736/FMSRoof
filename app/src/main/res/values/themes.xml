<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FMSRoof" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryDark">@color/blue_dark</item>
        <item name="colorAccent">@color/blue_light</item>
        <item name="android:statusBarColor">@color/blue_primary</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.FMSRoof" parent="Base.Theme.FMSRoof" />

    <style name="Theme.FMSRoof.Splash" parent="Theme.FMSRoof">
        <item name="android:windowBackground">@color/blue_primary</item>
        <item name="android:statusBarColor">@color/blue_primary</item>
    </style>

    <style name="Theme.FMSRoof.Fullscreen" parent="Theme.FMSRoof">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>